# Medien gehoeren nicht ins Repository: die Inbox ist ein Durchlauf,
# die Mediathek ist das Ergebnis und kann sehr gross werden.
inbox/*
!inbox/.gitkeep
mediathek/

# Laufzeitordner: ein Protokoll je echtem Import. Das Importskript legt den
# Ordner selbst an, er muss also nicht im Repository stehen. Die bebilderte
# Anwenderanleitung lag frueher hier und liegt jetzt in docs/.
protokolle/

# Sicherungskopien: einstellungen.json.bak legt die Weboberflaeche an,
# Importiere-Medien.ps1.bak-<zeitstempel> die Handarbeit vor groesseren Eingriffen.
*.bak
*.bak-*

# Windows-Beifang
Thumbs.db
desktop.ini

# Die eigene Einstellungsdatei gehoert zum Rechner, nicht ins Repository: sie
# traegt absolute Pfade und greift vor den eingebauten Standardwerten. Versioniert
# ist nur die Vorlage daneben.
config/einstellungen.json

# Das gebaute Setup. Veroeffentlicht wird es als Release-Datei, nicht hier.
installer/ausgabe/

# Arbeitsunterlagen der Entwicklung (Specs, Umsetzungsplaene, Fortschritt).
# Sie tragen Pfade dieses Rechners und helfen niemandem, der das Programm nutzt.
docs/superpowers/
.superpowers/
